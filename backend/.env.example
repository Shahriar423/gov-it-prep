APP_NAME=Gov IT Prep Portal API
ENVIRONMENT=development
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<your-cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=gov_it_prep
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Never share or commit the real value.
JWT_SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PDF source materials (optional: these are the defaults)
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300

# Previous-year PDF extraction is rule-based and needs NO AI settings.
# Start extracting questions from previous-year PDFs automatically after upload (true/false)
PYQ_AUTO_EXTRACT=true

# AI is OPTIONAL and used only to generate questions from STUDY NOTES (Source materials).
# Leave these empty if you do not use that feature. Never share or commit the real key.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL is only needed when AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_TIMEOUT_SECONDS=90
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_REQUESTS_PER_DAY=200